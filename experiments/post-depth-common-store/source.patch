+    sg_i32x4 words = _mm_packus_epi32(quantized, quantized);
+    uint32_t packed = (uint32_t)_mm_cvtsi128_si32(_mm_packus_epi16(words, words));
+    memcpy(c->fb.color + pixel * 4, &packed, sizeof(packed));
