+/* Diagnostic counters are written only by the caller: geometry replay and
+ * retired-job publication never execute on helper threads. Read between
+ * joined resolves; no atomics or hot raster instrumentation are added. */
+static uint64_t sg_depth_replay_counts[3][4];
+__attribute__((used, noinline))
+double sg_depth_replay_diag_counter(int samples, int field) {
+    if ((samples != 0 && samples != 2 && samples != 4) || field < 0 || field >= 4)
+        return -1.;
+    return (double)sg_depth_replay_counts[samples / 2][field];
+}
