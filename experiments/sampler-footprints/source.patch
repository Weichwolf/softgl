+static unsigned sg_tex_diag_distinct(const uint64_t indices[4]) {
+    unsigned unique = 0;
+    for (int k = 0; k < 4; k++) {
+        int duplicate = 0;
+        for (int j = 0; j < k; j++) if (indices[j] == indices[k]) duplicate = 1;
+        unique += !duplicate;
+    }
+    return unique;
