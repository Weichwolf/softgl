+    unsigned slots = atomic_load_explicit(&sg_tex_diag_next, memory_order_relaxed);
+    if (slots > SG_TEX_DIAG_THREADS) slots = SG_TEX_DIAG_THREADS;
+    memset(sg_tex_diag_rows, 0, slots * sizeof(sg_tex_diag_rows[0]));
