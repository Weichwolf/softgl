+/* Strict rejection of a partial row span needs the same bound as whole
+ * triangles. A tie cannot become reusable depth visibility. */
+SG_INLINE const sg_hz_state *sg_hz_span_prepare4(const softgl_ctx *c,
+        float z0, float z1, float z2, float offset, float *lower) {
+    const sg_hz_state *state = sg_hz_state_from_ctx4(c);
+    if (!state || !state->active || !c->depth_test || c->stencil_test ||
+        (c->depth_func != GL_LESS && c->depth_func != GL_LEQUAL)) return NULL;
+    if (!(z0 >= 0.f && z0 <= 1.f && z1 >= 0.f && z1 <= 1.f && z2 >= 0.f && z2 <= 1.f)) return NULL;
+    uint32_t bits; memcpy(&bits, &offset, 4);
+    if ((bits & UINT32_C(0x7f800000)) == UINT32_C(0x7f800000)) return NULL;
+    float near = z0 < z1 ? z0 : z1; if (z2 < near) near = z2;
+    float bound = near + offset - 2e-6f * (1.f + fabsf(offset));
+    *lower = bound < 0.f ? 0.f : bound > 1.f ? 1.f : bound;
+    return state;
+}
