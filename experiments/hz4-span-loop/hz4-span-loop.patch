--- /dev/null
+++ b/tests/hz_span.c
@@ -0,0 +1,128 @@
+#include "types.h"
+#include "workers.h"
+#include "raster_hz.h"
+#include <stdio.h>
+#include <math.h>
+
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "line %d: %s\n", __LINE__, #x); return 1; } } while (0)
+
+static unsigned calls, pixels, partial_starts, partial_ends, bad_skips;
+
+void sg_hz_span_test_skip(int x, int y, int count) {
+    calls++;
+    pixels += (unsigned)count;
+    partial_starts += !!(x & 3);
+    partial_ends += count < 4 - (x & 3);
+    bad_skips += x < 0 || x + count > 64 || y < 0 || y >= 32 ||
+        count < 1 || count > 4 - (x & 3);
+}
+
+static void prepare(softgl_ctx *c, int enabled, int variant) {
+    softgl_make_current(c);
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_STENCIL_TEST);
+    glDisable(GL_ALPHA_TEST);
+    glDisable(GL_BLEND);
+    glDisable(GL_SAMPLE_ALPHA_TO_COVERAGE);
+    glDisable(GL_SAMPLE_COVERAGE);
+    glDepthMask(GL_TRUE);
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_LESS);
+    glClearDepth(1);
+    glClearColor(.1f, .2f, .3f, 1);
+    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT);
+    sg_hz_state_from_ctx(c)->active = 1;
+    float color[4] = {.25f, .5f, .25f, 1};
+    for (int y = 0; y < c->fb.h; y++) for (int x = 0; x < 64; x++) {
+        float z[4] = {.2f, .2f, .2f, .2f};
+        sg_write_multisample(c, x, y, 15, z, color);
+    }
+    if (variant & 1) {
+        glEnable(GL_BLEND);
+        glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    }
+    if (variant & 2) {
+        glEnable(GL_ALPHA_TEST);
+        glAlphaFunc(GL_GREATER, .4f);
+    }
+    if (variant & 4) {
+        glEnable(GL_STENCIL_TEST);
+        glStencilFunc(GL_ALWAYS, 3, 255);
+        glStencilOp(GL_INCR, GL_DECR, GL_REPLACE);
+    }
+    if (variant & 8) glDepthMask(GL_FALSE);
+    if (variant & 16) glEnable(GL_SAMPLE_ALPHA_TO_COVERAGE);
+    sg_hz_state_from_ctx(c)->active = enabled;
+}
+
+static int draw(softgl_ctx *c, int shape) {
+    sg_vert v[3] = {0};
+    v[0].ndc = (sg_vec4){5.125f + shape % 7, 1.375f + shape % 3, .8f, 1};
+    v[1].ndc = (sg_vec4){107.625f - shape % 11, 3.125f + shape % 5, .8f, 1};
+    v[2].ndc = (sg_vec4){13.375f + shape % 9, 30.875f - shape % 7, .8f, 1};
+    if (shape & 8) {
+        v[0].ndc.z = .55f;
+        v[1].ndc.z = .95f;
+        v[2].ndc.z = .65f;
+    }
+    if (shape & 16) for (int i = 0; i < 3; i++) v[i].ndc.z = 0;
+    for (int i = 0; i < 3; i++)
+        v[i].color = v[i].color_back = (sg_vec4){.3f + .2f * i, .8f, .2f, .3f + .2f * i};
+    sg_tex_tri_ctx texture;
+    sg_tex_tri_prepare(c, &texture);
+    sg_worker_bin bin = {0};
+    bin.depth_capture = 1;
+    sg_raster_bin = &bin;
+    int result = sg_raster_triangle_tile_prepared(c, v, v + 1, v + 2,
+        0, c->fb.w, &texture);
+    sg_raster_bin = NULL;
+    return result;
+}
+
+int main(void) {
+    softgl_ctx *c = softgl_create_multisample(128, 35, 4);
+    softgl_ctx *reference = softgl_create_multisample(128, 35, 4);
+    CHECK(c && reference);
+    sg_workers_shutdown(c);
+    sg_workers_shutdown(reference);
+    CHECK(sg_hz_active4(c) && sg_hz_active4(reference));
+    unsigned cases = 0, total_calls = 0, total_pixels = 0, starts = 0, ends = 0;
+    for (int variant = 0; variant < 32; variant++) for (int shape = 0; shape < 32; shape++) {
+        prepare(c, 1, variant);
+        calls = pixels = partial_starts = partial_ends = bad_skips = 0;
+        int result = draw(c, shape);
+        CHECK(!bad_skips);
+        if (calls) CHECK(result != 1);
+        if ((variant & 4) || (shape & 16)) CHECK(!calls);
+        total_calls += calls;
+        total_pixels += pixels;
+        starts += partial_starts;
+        ends += partial_ends;
+        prepare(reference, 0, variant);
+        calls = pixels = partial_starts = partial_ends = bad_skips = 0;
+        draw(reference, shape);
+        CHECK(!calls);
+        CHECK(!memcmp(c->fb.sample_color, reference->fb.sample_color, 128 * 35 * 16));
+        CHECK(!memcmp(c->fb.sample_depth, reference->fb.sample_depth, 128 * 35 * 4 * sizeof(float)));
+        CHECK(!memcmp(c->fb.sample_stencil, reference->fb.sample_stencil, 128 * 35 * 4));
+        CHECK(glGetError() == GL_NO_ERROR);
+        cases++;
+    }
+    CHECK(total_calls && total_pixels && starts && ends);
+    prepare(c, 1, 0);
+    float lower;
+    CHECK(sg_hz_span_prepare4(c, .8f, .9f, 1, 0, &lower));
+    CHECK(lower == .8f - 2e-6f);
+    CHECK(!sg_hz_span_prepare4(c, .8f, .9f, 1, NAN, &lower));
+    CHECK(!sg_hz_span_prepare4(c, .8f, .9f, 1, INFINITY, &lower));
+    c->stencil_test = 1;
+    CHECK(!sg_hz_span_prepare4(c, .8f, .9f, 1, 0, &lower));
+    c->stencil_test = 0;
+    c->depth_func = GL_EQUAL;
+    CHECK(!sg_hz_span_prepare4(c, .8f, .9f, 1, 0, &lower));
+    softgl_destroy(reference);
+    softgl_destroy(c);
+    printf("HZ spans: %u exact sample-plane cases, %u observed skips, %u skipped row pixels, %u partial starts, %u partial ends passed\n",
+        cases, total_calls, total_pixels, starts, ends);
+    return 0;
+}
