+}
+double sg_fragment_mask_stat(int index) {
+    return index >= 0 && index < 8 ? (double)sg_fragment_mask_stats[index] : -1;
+}
+
+/* References, allocations and shared budget accounting belong to the caller.
+ * Jobs retain immutable replay storage across cache invalidation/replacement. */
+static void sg_fragment_mask_release(sg_fragment_mask_cache *s) {
+    if (!s || --s->refs) return;
+    *s->owner_bytes -= s->allocation;
+    sg_fragment_mask_stats[6] -= s->allocation;
+    sg_aligned_free(s);
+}
+static void sg_fragment_mask_forget(sg_geometry_entry *entry) {
+    sg_fragment_mask_release(entry->fragments); entry->fragments = NULL;
+}
+static int sg_pool_sort_safe(const softgl_ctx *c);
+static void sg_fragment_mask_ticket_release(sg_worker_pool *p) {
+    sg_fragment_mask_release(p->prepared_fragment_replay);
+    p->prepared_fragment_replay = NULL;
+}
+static void sg_fragment_mask_evict(sg_geometry_cache *cache, size_t need) {
+    if (need <= SG_GEOMETRY_CACHE_BYTES - cache->bytes) return;
+    for (int i = 0; i < SG_GEOMETRY_CACHE_ENTRIES; i++) sg_fragment_mask_forget(&cache->entries[i]);
+}
+static sg_fragment_mask_cache *sg_fragment_mask_create(softgl_ctx *c, sg_worker_pool *p,
+                                                       const sg_geometry_entry *entry) {
+    if (sg_fragment_mask_disabled || !entry || !entry->fragment_wanted || c->scissor_enabled ||
+        (c->fb.samples != 2 && c->fb.samples != 4) || c->fb.w > 65535 || c->fb.h > 65535) return NULL;
