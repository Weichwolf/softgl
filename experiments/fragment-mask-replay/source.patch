+    uint32_t count = (uint32_t)entry->offsets[p->nbins];
+    size_t head = (sizeof(sg_fragment_mask_cache) + (size_t)count * 4 + 63) & ~(size_t)63;
+    size_t want = (head + (size_t)count * 32 + (size_t)p->nbins * 128 + 63) & ~(size_t)63;
+    size_t available = ((SG_GEOMETRY_CACHE_BYTES - owner->bytes) / 4) & ~(size_t)63;
+    if (available > 262144) available = 262144;
+    if (want > available) want = available;
+    if (!count || want <= head + (size_t)p->nbins * 16) return NULL;
+    sg_fragment_mask_cache *s = sg_aligned_alloc(want, 64);
+    if (!s) return NULL;
+    memset(s, 0, sizeof(*s));
+    s->allocation = want; s->owner_bytes = &owner->bytes; s->refs = 1;
+    s->width = c->fb.w; s->height = c->fb.h; s->samples = c->fb.samples;
+    s->multisample = c->multisample; s->nbins = p->nbins; s->count = count;
+    s->offsets = (uint32_t *)(s + 1); s->data = (uint8_t *)s + head;
+    memset(s->offsets, 255, (size_t)count * 4);
+    uint32_t used = 0, capacity = (uint32_t)(want - head);
+    for (int b = 0; b < p->nbins; b++) {
+        sg_fragment_mask_bin *bin = &s->bins[b];
+        bin->first = (uint32_t)entry->offsets[b]; bin->end = (uint32_t)entry->offsets[b + 1];
+        bin->start = used;
+        bin->capacity = (uint32_t)((uint64_t)capacity * bin->end / count) - used;
+        used += bin->capacity;
+    }
+    owner->bytes += want;
+    sg_fragment_mask_stats[0]++;
+    sg_fragment_mask_stats[6] += want;
+    if (owner->bytes > sg_fragment_mask_stats[4]) sg_fragment_mask_stats[4] = owner->bytes;
+    return s;
+}
+static void sg_fragment_mask_capture_triangle(sg_fragment_mask_cache *s, int b, uint32_t original) {
+    memset(&sg_fragment_mask_current, 0, sizeof(sg_fragment_mask_current));
