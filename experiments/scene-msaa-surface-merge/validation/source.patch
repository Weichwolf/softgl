+/* Untimed opportunity census: no buffers, winners or shade masks are changed.
+ * Adjacency is only an upper bound; normals, UV footprint and image error
+ * still need validation before any representative color may be shared. */
+static unsigned scene_surface_root(unsigned parent[4], unsigned at) {
+    while (parent[at] != at) at = parent[at];
+    return at;
+}
+
+static int scene_surface_adjacent(const scene_triangle *a, const scene_triangle *b) {
+    const scene_primitive *p = a->primitive, *q = b->primitive;
+    if (!p || !q || p->clipped != UINT32_MAX || q->clipped != UINT32_MAX) return 0;
+    unsigned shared = 0;
+    for (unsigned i = 0; i < 3; i++) {
+        for (unsigned j = 0; j < 3; j++) if (p->indices[i] == q->indices[j]) {
+            shared++; break;
+        }
+    }
+    return shared == 2;
+}
+
+static void scene_surface_census(const struct sg_scene_visibility *f) {
+    const softgl_ctx *c = f->context;
+    unsigned n = (unsigned)c->fb.samples;
+    if (!n || !f->deferred_meshes) return;
+    uint64_t groups = 0, pixels = 0, material_groups = 0, adjacent_groups = 0;
+    uint64_t alpha_groups = 0, clipped_groups = 0, multi_group_pixels = 0;
+    uint64_t pair_same_material = 0, pair_adjacent = 0;
+    for (size_t p = 0; p < (size_t)c->fb.w*c->fb.h; p++) {
+        unsigned parent[4], count = 0, distinct_materials = 0;
+        const scene_triangle *triangles[4];
+        uint16_t materials[4];
+        for (unsigned s = 0; s < n; s++) {
+            size_t at = p*n+s;
+            if (!f->shade_mask[at]) continue;
+            uint32_t winner = f->winner[at];
+            parent[count] = count;
+            materials[count] = f->pixel_material[at];
+            triangles[count] = &f->bins[winner >> SCENE_INDEX_BITS].triangles[winner & SCENE_INDEX_MASK];
+            alpha_groups += f->materials[materials[count]].alpha_test != 0;
+            clipped_groups += triangles[count]->primitive && triangles[count]->primitive->clipped != UINT32_MAX;
+            unsigned previous = 0;
+            for (unsigned k = 0; k < count; k++) previous |= materials[k] == materials[count];
+            distinct_materials += !previous;
+            count++;
+        }
+        groups += count; pixels += count != 0; multi_group_pixels += count > 1;
+        material_groups += distinct_materials;
+        for (unsigned i = 0; i < count; i++) for (unsigned j = i+1; j < count; j++) {
+            if (materials[i] != materials[j]) continue;
+            pair_same_material++;
+            if (f->materials[materials[i]].alpha_test ||
+                !scene_surface_adjacent(triangles[i],triangles[j])) continue;
+            pair_adjacent++;
+            unsigned a = scene_surface_root(parent,i), b = scene_surface_root(parent,j);
+            parent[b] = a;
+        }
+        for (unsigned i = 0; i < count; i++) adjacent_groups += scene_surface_root(parent,i) == i;
+    }
+    fprintf(stderr,"SURFACE_CENSUS {\"samples\":%u,\"groups\":%llu,\"occupiedPixels\":%llu,"
+        "\"multiGroupPixels\":%llu,\"sameMaterialMinimumGroups\":%llu,\"adjacentMinimumGroups\":%llu,"
+        "\"alphaGroups\":%llu,\"clippedGroups\":%llu,\"sameMaterialPairs\":%llu,\"adjacentPairs\":%llu}\n",
+        n,(unsigned long long)groups,(unsigned long long)pixels,(unsigned long long)multi_group_pixels,
+        (unsigned long long)material_groups,(unsigned long long)adjacent_groups,
+        (unsigned long long)alpha_groups,(unsigned long long)clipped_groups,
+        (unsigned long long)pair_same_material,(unsigned long long)pair_adjacent);
+}
