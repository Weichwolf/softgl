                           row[2]+dx[2]*256*(first_x-ix0)};
         for (int x = first_x; x < end_x; x++) {
 #if SG_MSAA_DEPTH_CAPTURE
             if (span_state && (x == first_x || !(x & 3))) {
+#ifdef SG_HZ_SPAN_COUNTERS
+                diagnostic->values[1]++;
+#endif
                 const sg_hz_tile *tile = span_state->tiles +
                     (size_t)(x >> 2) * span_state->rows + (y >> 2);
                 if (tile->written == UINT64_MAX && span_lower > tile->maximum) {
                     int skip = 4 - (x & 3);
                     if (skip > end_x - x) skip = end_x - x;
