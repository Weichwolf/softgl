+    attempted_allocations = 0; sg_prepack_prepare(c, &p, VERTICES, 1);
+    CHECK(p.prepacked.data == idle && !p.stream_queue->slots[2].draw->packed.data);
+    CHECK(!attempted_allocations && owned_bytes(&p) <= SG_STREAM_BYTES);
