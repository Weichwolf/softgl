+static void model_key_reset(void) {
+    for (int i = 0; i < 3; i++) sg_key_destroy(&model_key_views[i]);
+    model_key_context = NULL; model_key_samples = -1; model_key_last_cached = 0;
+    model_key_camera_cooldown = 0;
+}
